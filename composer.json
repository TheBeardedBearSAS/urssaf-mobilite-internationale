{
    "name": "thebeardedbear/urssaf-mobilite-internationale",
    "description": "Client and domain model for the URSSAF \"API Mobilité internationale\" (posting of workers within the EEA)",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "urssaf",
        "api",
        "mobilite-internationale",
        "detachement",
        "certificat-a1",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "The Bearded Bear",
            "homepage": "https://the-bearded-bear.com"
        }
    ],
    "homepage": "https://the-bearded-bear.com/open-source/urssaf-mobilite-internationale",
    "support": {
        "issues": "https://github.com/TheBeardedBearSAS/urssaf-mobilite-internationale/issues",
        "source": "https://github.com/TheBeardedBearSAS/urssaf-mobilite-internationale",
        "security": "https://github.com/TheBeardedBearSAS/urssaf-mobilite-internationale/security/policy"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "deptrac/deptrac": "^4.7",
        "ergebnis/composer-normalize": "^2.56",
        "ergebnis/phpstan-rules": "^2.17",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9",
        "infection/infection": "^0.32",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8.2",
        "php-http/client-common": "^2.7.2",
        "php-http/discovery": "^1.19.3",
        "php-http/httplug": "^2.4.1",
        "php-http/message": "^1.16.1",
        "php-http/mock-client": "^1.6.1",
        "php-http/promise": "^1.2.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest",
        "shipmonk/phpstan-rules": "^4.4",
        "symfony/cache": "^6.4 || ^7.4 || ^8.0",
        "symfony/cache-contracts": "^2.5.3 || ^3.4.2",
        "symfony/clock": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/config": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4.26 || ^7.4 || ^8.0",
        "symfony/error-handler": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/event-dispatcher-contracts": "^2.5.3 || ^3.4.2",
        "symfony/filesystem": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/polyfill-php83": "^1.31",
        "symfony/process": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/property-access": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/property-info": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/serializer": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/string": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/translation": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/translation-contracts": "^2.5.3 || ^3.4.2",
        "symfony/uid": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/validator": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/var-dumper": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/var-exporter": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "conflict": {
        "nyholm/psr7": "<1.8.2",
        "symfony/clock": "<6.4.3",
        "symfony/console": "<6.4",
        "symfony/dependency-injection": "<6.4.26",
        "symfony/framework-bundle": "<6.4.3",
        "symfony/http-client": "<6.4",
        "symfony/http-kernel": "<6.4"
    },
    "suggest": {
        "nyholm/psr7": "PSR-17 factories for the HTTP gateway (any PSR-17 implementation works)",
        "symfony/cache": "PSR-6 pool for the OAuth2 token cache (Psr6TokenStore)",
        "symfony/config": "Required by the Symfony bridge (bundle configuration)",
        "symfony/console": "Provides the urssaf:mi:* console commands of the bundle",
        "symfony/dependency-injection": "Required by the Symfony bridge",
        "symfony/framework-bundle": "Required to use the Symfony bundle",
        "symfony/http-client": "PSR-18 compatible HTTP client for the API",
        "symfony/http-kernel": "Required by the Symfony bridge (bundle)",
        "symfony/translation": "Translates the violation codes and the command failures (English and French shipped)"
    },
    "autoload": {
        "psr-4": {
            "TheBeardedBear\\UrssafMobiliteInternationale\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheBeardedBear\\UrssafMobiliteInternationale\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
